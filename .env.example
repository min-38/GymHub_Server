# 이 파일을 .env 로 복사해 실제 값을 채운다(.env 는 커밋 금지 — .gitignore 에 추가됨).

# Neon Postgres 연결 문자열. Neon 콘솔 > Connection string 에서 복사.
# 예: Host=ep-xxx.ap-southeast-1.aws.neon.tech;Database=gymhub;Username=...;Password=...
NEON_CONNECTION_STRING=

# JWT 서명 키(32바이트 이상). 예: openssl rand -base64 48
JWT_KEY=

# 테스트 모드. true 면 Google 없이 /auth/dev-login 으로 접속 가능. 운영 배포 시 false 또는 삭제.
ALLOW_DEV_LOGIN=true

# 실제 Google 로그인 테스트 시에만 입력(Web 클라이언트 ID). dev-login 만 쓰면 비워둠.
GOOGLE_CLIENT_ID=
